# Copy to .env and fill in real values; protect this file (mode 0600).
# Current database pools use these same credentials as process bootstrap.
# Existing volumes retain their initialized passwords: never regenerate them.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=echo_db
MYSQL_USER=echo_app
MYSQL_PASSWORD=change-me-app

# Every consumer connects directly to PlatformConfig/cfg_tbl_Setting.
# Generate separate service tokens with the needed read access in NocoDB.
# Do not mount Identity's config.json or copy its personal bootstrap token.
NOCODB_BASE_URL=http://nocodb:8080
ECHO_WEB_NOCODB_API_TOKEN=
ECHO_SERVICE_NOCODB_API_TOKEN=

# Runtime values belong in scopes echo-web > echo > * or echo-service > echo > *.
# Seed and verify required values before starting the stack (README.md).
# EchoMedia needs no NocoDB token; its port and mounted media path stay in compose.
